{
  "manifest_version": 3,
  "name": "支付信息生成器",
  "version": "2.0",
  "description": "生成测试用支付数据并自动填充到表单中",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "activeTab",
    "sidePanel"
  ],
  "host_permissions": ["<all_urls>"],
  "incognito": "split",
  "action": {
    "default_icon": {
      "16": "icons/icon64.png",
      "48": "icons/icon64.png",
      "128": "icons/icon64.png"
    }
  },
  "background": {
    "service_worker": "background-simple.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["auto-fill.js"],
      "run_at": "document_end",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "services/generator.js",
        "auto-fill.js"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
